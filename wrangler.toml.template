# 사장님봇 wrangler 설정 템플릿
# 새 Cloudflare 계정에서 리소스 생성 후 <...> 를 채워 wrangler.toml 로 복사.
# KOH봇 리소스 ID 재사용 금지 (데이터 섞임).

name = "pres-ai-bot"
main = "src/index.js"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]
keep_vars = true

# Secrets (커밋 금지):
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put TAVILY_API_KEY      # 뉴스·웹검색 (월 1000건 무료)

[vars]
BRIEFING_CHAT_ID = "<수집_방ID들_쉼표구분>"   # 단체방·1:1 DM 방 ID
BRIEFING_TARGET_ID = "<브리핑_받을_방ID>"      # 비우면 첫 방으로 발송
BOT_USERNAME = "<새_봇_username>"

[triggers]
crons = ["0 23 * * 0-4"]   # 평일 KST 08:00 (UTC 23:00)

[[d1_databases]]
binding = "DB"
database_name = "pres-ai-db"
database_id = "<새_D1_id>"

[[kv_namespaces]]
binding = "STATE"
id = "<새_KV_id>"

# ── R2 (파일 원본 영구보존 + 텍스트추출 검색) ─────────────
# 파일 수신 시 원본을 R2 에 자동 업로드한다 (collect.js → env.R2).
# 버킷 생성(1회):
#   wrangler r2 bucket create ysj-files
[[r2_buckets]]
binding = "R2"
bucket_name = "ysj-files"
