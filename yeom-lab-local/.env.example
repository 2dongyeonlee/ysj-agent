# yeom-lab-local 환경변수. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)

# 필수 — BotFather 로 만든 새 봇의 토큰 (그룹방 채팅용 봇 토큰과 다른 값이어야 함)
TELEGRAM_BOT_TOKEN=

# 필수 — Claude API 키 (요약·브리핑·회의록 생성)
ANTHROPIC_API_KEY=

# 선택 — 녹음 STT (없으면 녹음→회의록 기능만 비활성)
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# 선택 — 웹 검색 (대외정보 브리핑 보강용)
TAVILY_API_KEY=

# 봇 @username(앞의 @ 는 빼고). 그룹방에서 멘션 인식에 쓰인다.
BOT_USERNAME=

# 자료 수집 대상 방 / 자동 브리핑 수신 방 / 관리자 명령 허용 방의 chat_id.
# 개인 DM 이면 양수, 그룹방이면 음수(-로 시작)로 옵니다.
# /whoami 를 봇에게 보내면 본인 chat_id 를 바로 확인할 수 있습니다.
BRIEFING_CHAT_ID=
BRIEFING_TARGET_ID=
ADMIN_CHAT_ID=

# 선택 — 관리자 @username 여러 개(쉼표 구분)
ADMIN_USERNAMES=

# 상황판(Mini App) 이 뜰 로컬 포트. 기본 8787 → http://localhost:8787/dashboard
DASHBOARD_PORT=8787

# 선택 — [📊 상황판] 텔레그램 버튼을 쓰려면 공개 HTTPS 주소가 필요합니다(텔레그램 정책).
# 예: cloudflared tunnel --url http://localhost:8787 로 얻은 https://xxxx.trycloudflare.com/dashboard
# 비워두면 버튼이 자동으로 숨겨지고, PC 로컬에서 http://localhost:8787/dashboard 로만 볼 수 있습니다.
DASHBOARD_URL=
