# yeom-lab-local 환경변수. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)

# 필수 — BotFather 로 만든 새 봇의 토큰 (그룹방 채팅용 봇 토큰과 다른 값이어야 함)
TELEGRAM_BOT_TOKEN=

# 분류·요약·브리핑·회의록 생성은 이 PC에서 직접 돌아가는 Ollama(무료 오픈소스 LLM)를 씁니다.
# 사전에 Ollama 설치 + 모델 다운로드 필요:
#   1) https://ollama.com 에서 설치
#   2) ollama pull qwen2.5:7b-instruct
#   3) ollama serve 로 백그라운드 실행 (보통 설치 시 자동 등록됨)
# 기본값 그대로 두면 http://localhost:11434 의 qwen2.5:7b-instruct 를 씁니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 녹음 받아쓰기(STT)도 로컬에서 — whisper.cpp 서버. API 키 불필요, 음성이 PC 밖으로 안 나감.
# 준비:
#   1) https://github.com/ggml-org/whisper.cpp/releases 에서 whisper-bin-x64.zip 다운로드·압축해제
#   2) 모델 받기: https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
#      (small=466MB 권장. 더 정확하게: ggml-large-v3-turbo.bin=1.5GB, 대신 느림)
#   3) 서버 실행 (봇과 별도 창에서 계속 띄워둘 것):
#      whisper-server.exe -m ggml-small.bin -l ko --convert --port 8080
#      ※ --convert 는 텔레그램 음성(ogg)을 변환하는 데 필요하며 PATH 에 ffmpeg 가 있어야 합니다.
# 비워두면 녹음→회의록 기능만 비활성화되고 나머지는 정상 동작합니다.
WHISPER_BASE_URL=http://localhost:8080
# 로컬 CPU 전사는 느립니다(10분 녹음에 5~15분). 기본 30분.
WHISPER_TIMEOUT_MS=1800000

# 선택 — 사진/PDF로 올린 문서를 읽는 기능(docparse.js)만 아직 Claude Vision API를 씁니다.
# 이 기능을 안 쓰면 비워둬도 됩니다.
ANTHROPIC_API_KEY=

# 선택 — 클라우드 STT 폴백. 위 whisper.cpp 를 쓰면 필요 없습니다.
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# 선택 — 웹 검색 (대외정보 브리핑 보강용)
TAVILY_API_KEY=

# 봇 @username(앞의 @ 는 빼고). 그룹방에서 멘션 인식에 쓰인다.
BOT_USERNAME=

# 자료 수집 대상 방 / 자동 브리핑 수신 방 / 관리자 명령 허용 방의 chat_id.
# 개인 DM 이면 양수, 그룹방이면 음수(-로 시작)로 옵니다.
# /whoami 를 봇에게 보내면 본인 chat_id 를 바로 확인할 수 있습니다.
BRIEFING_CHAT_ID=
BRIEFING_TARGET_ID=
ADMIN_CHAT_ID=

# 선택 — 관리자 @username 여러 개(쉼표 구분)
ADMIN_USERNAMES=

# 상황판(Mini App) 이 뜰 로컬 포트. 기본 8787 → http://localhost:8787/dashboard
DASHBOARD_PORT=8787

# 선택 — [📊 상황판] 텔레그램 버튼을 쓰려면 공개 HTTPS 주소가 필요합니다(텔레그램 정책).
# 예: cloudflared tunnel --url http://localhost:8787 로 얻은 https://xxxx.trycloudflare.com/dashboard
# 비워두면 버튼이 자동으로 숨겨지고, PC 로컬에서 http://localhost:8787/dashboard 로만 볼 수 있습니다.
DASHBOARD_URL=
